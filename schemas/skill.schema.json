{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toolhub.local/schemas/skill.schema.json",
  "title": "ToolHub Skill Manifest",
  "type": "object",
  "required": [
    "schema",
    "id",
    "name"
  ],
  "properties": {
    "schema": {
      "const": "toolhub.skill/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "instruction",
        "mcp",
        "package"
      ]
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "capability"
        ],
        "properties": {
          "capability": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "optional": {
            "type": "boolean"
          }
        }
      }
    },
    "optional": {
      "type": "array"
    },
    "instruction_file": {
      "type": "string"
    },
    "mcp_config": {
      "type": "string"
    },
    "package_path": {
      "type": "string"
    },
    "portability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "platforms",
        "inputs",
        "outputs",
        "permissions",
        "host_dependencies"
      ],
      "properties": {
        "scope": {
          "enum": [
            "portable",
            "host_specific"
          ]
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "enum": [
              "windows",
              "macos",
              "linux"
            ]
          }
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "permissions": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "enum": [
              "read_files",
              "write_files",
              "execute_tools",
              "network_access"
            ]
          }
        },
        "host_dependencies": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    }
  },
  "additionalProperties": false
}
