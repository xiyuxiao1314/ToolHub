{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ToolHub task artifact package",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "maxLength": 256
    },
    "task": {
      "type": "string",
      "maxLength": 2048
    },
    "source": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "root": {
      "type": "string"
    },
    "priority": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "retained": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "active",
        "scheduled",
        "needs_review",
        "retained",
        "awaiting_scope",
        "recycling",
        "trashed",
        "blocked",
        "partial",
        "released"
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "relative_path": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 268435456
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "modified_ns": {
            "type": "string"
          },
          "status": {
            "enum": [
              "present",
              "trashed",
              "released"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "relative_path",
          "bytes",
          "sha256",
          "modified_ns",
          "status",
          "error"
        ]
      }
    },
    "completed": {
      "type": "boolean"
    },
    "no_longer_needed": {
      "type": "boolean"
    },
    "cleanup_after": {
      "type": [
        "integer",
        "null"
      ]
    },
    "reason": {
      "type": "string"
    },
    "reviewer": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "task",
    "source",
    "owner",
    "root",
    "priority",
    "retained",
    "status",
    "files",
    "completed",
    "no_longer_needed",
    "cleanup_after",
    "reason",
    "reviewer",
    "created_at",
    "updated_at"
  ]
}
