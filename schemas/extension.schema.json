{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toolhub.local/schemas/extension.schema.json",
  "title": "ToolHub declarative extension v1",
  "description": "Maximum complete UTF-8 package size 256 KiB. Namespace, semantic version, alias, portable Skill and filename collision checks are authoritative in the Rust validator. No executable payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "description",
    "version",
    "author",
    "license",
    "platforms",
    "min_toolhub_version"
  ],
  "properties": {
    "schema": {
      "const": "toolhub.extension/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "windows",
          "macos",
          "linux"
        ]
      }
    },
    "min_toolhub_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "recognition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "name",
        "version",
        "kind",
        "capabilities",
        "tools"
      ],
      "properties": {
        "schema": {
          "const": "toolhub.resource/v1"
        },
        "kind": {
          "const": "recognition"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "capabilities": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "definition_id",
              "name",
              "vendor",
              "file_names",
              "capabilities"
            ],
            "properties": {
              "definition_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "vendor": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "file_names": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[^/\\\\:*?\\x00-\\x1f]+$"
                }
              },
              "path_substrings": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "capabilities": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            }
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "skill-bundle.schema.json"
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "recognition"
      ]
    },
    {
      "required": [
        "skills"
      ],
      "properties": {
        "skills": {
          "minItems": 1
        }
      }
    }
  ]
}
