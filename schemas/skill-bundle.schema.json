{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toolhub.local/schemas/skill-bundle.schema.json",
  "title": "ToolHub Portable Instruction Bundle",
  "description": "UTF-8 JSON, at most 131072 bytes. Runtime validation additionally checks combined requirements <=32, UTF-8 byte limits, known host APIs and declaration compatibility.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "category",
    "tags",
    "author",
    "license",
    "manifest",
    "instructions"
  ],
  "properties": {
    "schema": {
      "const": "toolhub.bundle/v1"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48
    },
    "category": {
      "enum": [
        "media",
        "document",
        "archive",
        "data",
        "general"
      ]
    },
    "tags": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "manifest": {
      "type": "object",
      "required": [
        "schema",
        "id",
        "name",
        "kind",
        "instruction_file",
        "portability"
      ],
      "properties": {
        "schema": {
          "const": "toolhub.skill/v1"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "kind": {
          "const": "instruction"
        },
        "requires": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "capability"
            ],
            "properties": {
              "capability": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string"
              },
              "optional": {
                "type": "boolean"
              }
            }
          }
        },
        "optional": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "capability"
            ],
            "properties": {
              "capability": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string"
              },
              "optional": {
                "type": "boolean"
              }
            }
          }
        },
        "instruction_file": {
          "const": "SKILL.md"
        },
        "portability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "platforms",
            "inputs",
            "outputs",
            "permissions",
            "host_dependencies"
          ],
          "properties": {
            "scope": {
              "const": "portable"
            },
            "platforms": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "enum": [
                  "windows",
                  "macos",
                  "linux"
                ]
              }
            },
            "inputs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "outputs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "permissions": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "enum": [
                  "read_files",
                  "write_files",
                  "execute_tools",
                  "network_access"
                ]
              }
            },
            "host_dependencies": {
              "type": "array",
              "maxItems": 0
            }
          }
        }
      },
      "additionalProperties": false
    },
    "instructions": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    }
  }
}
